{
  "name": "@mcpatch/extension",
  "version": "0.1.0",
  "private": true,
  "description": "MCPatch Chromium Manifest V3 browser runtime",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:browser": "cargo build --locked --package mcpatch-bridge && pnpm build && node scripts/build-chromium-fixture.mjs && playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@mcpatch/example-packs": "workspace:*",
    "@mcpatch/google-flights-pack": "workspace:*",
    "@mcpatch/protocol": "workspace:*",
    "@mcpatch/sdk": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "24.13.4",
    "daisyui": "^5.7.37",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
