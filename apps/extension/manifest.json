{
  "manifest_version": 3,
  "name": "MCPatch",
  "version": "0.1.0",
  "description": "Safe, typed website capabilities for MCP clients.",
  "key": "",
  "minimum_chrome_version": "106",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage"],
  "optional_host_permissions": [
    "https://www.google.com/*",
    "https://www.tradingview.com/*",
    "https://pricealerts.tradingview.com/*",
    "https://symbol-search.tradingview.com/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "MCPatch"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
