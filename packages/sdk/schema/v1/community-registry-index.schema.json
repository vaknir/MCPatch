{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpatch.dev/schema/community-registry-index/v1",
  "title": "MCPatch Community Registry Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "indexVersion",
    "registryId",
    "publicationSequence",
    "issuedAt",
    "expiresAt",
    "packs",
    "signature"
  ],
  "properties": {
    "indexVersion": { "const": 1 },
    "registryId": { "$ref": "#/$defs/registryId" },
    "publicationSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "packs": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/pack" }
    },
    "signature": { "$ref": "#/$defs/indexSignature" }
  },
  "$defs": {
    "registryId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,63}$"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "id",
        "name",
        "description",
        "version",
        "bundleDigest",
        "bundlePath",
        "publisherKey",
        "trust",
        "origins",
        "tools",
        "compatibility",
        "networkPolicy",
        "verification",
        "revocation",
        "attestation"
      ],
      "properties": {
        "publisher": { "$ref": "#/$defs/publisher" },
        "id": { "$ref": "#/$defs/packId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": { "$ref": "#/$defs/semver" },
        "bundleDigest": { "$ref": "#/$defs/digest" },
        "bundlePath": {
          "type": "string",
          "pattern": "^/v1/bundles/[a-z][a-z0-9]{0,63}/[a-z](?:[a-z0-9-]*[a-z0-9])?/[0-9A-Za-z.+-]+/[a-f0-9]{64}\\.mcpack$"
        },
        "publisherKey": { "$ref": "#/$defs/publicKey" },
        "trust": { "enum": ["OFFICIAL", "REVIEWED_COMMUNITY"] },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^/*?#]+$"
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/tool" }
        },
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extensionRequests"],
          "properties": { "extensionRequests": { "const": "none" } }
        },
        "verification": { "$ref": "#/$defs/verification" },
        "revocation": { "$ref": "#/$defs/revocation" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "risk", "permissions"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "risk": { "enum": ["read", "action", "sensitive"] },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "READ",
              "ACTION",
              "SENSITIVE",
              "CREDENTIAL",
              "EXTERNAL_NETWORK",
              "ARBITRARY_EXECUTION"
            ]
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "bridgeProtocol"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximumExclusive"],
          "properties": {
            "minimum": { "$ref": "#/$defs/semver" },
            "maximumExclusive": { "$ref": "#/$defs/semver" }
          }
        },
        "bridgeProtocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 1 },
            "maximum": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedAt",
        "fixtureTestsPassed",
        "fixtureTestsTotal",
        "sourceCommit"
      ],
      "properties": {
        "verifiedAt": { "$ref": "#/$defs/timestamp" },
        "fixtureTestsPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fixtureTestsTotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      }
    },
    "revocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "ACTIVE" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "revokedAt", "reason"],
          "properties": {
            "status": { "const": "REVOKED" },
            "revokedAt": { "$ref": "#/$defs/timestamp" },
            "reason": { "enum": ["SECURITY", "PUBLISHER", "SUPERSEDED"] }
          }
        }
      ]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestationVersion",
        "registryId",
        "keyId",
        "publisher",
        "id",
        "version",
        "bundleDigest",
        "publicationSequence",
        "reviewState",
        "issuedAt",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "attestationVersion": { "const": 1 },
        "registryId": { "$ref": "#/$defs/registryId" },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519:[a-z][a-z0-9.-]{1,63}:sha256:[a-f0-9]{64}$"
        },
        "publisher": { "$ref": "#/$defs/publisher" },
        "id": { "$ref": "#/$defs/packId" },
        "version": { "$ref": "#/$defs/semver" },
        "bundleDigest": { "$ref": "#/$defs/digest" },
        "publicationSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reviewState": { "enum": ["OFFICIAL", "REVIEWED_COMMUNITY"] },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "indexSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signatureVersion", "algorithm", "keyId", "signature"],
      "properties": {
        "signatureVersion": { "const": 1 },
        "algorithm": { "const": "Ed25519" },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519:[a-z][a-z0-9.-]{1,63}:sha256:[a-f0-9]{64}$"
        },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      }
    }
  }
}
