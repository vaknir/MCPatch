{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpatch.dev/schema/pack-manifest/v1",
  "title": "MCPatch Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "publisher",
    "id",
    "name",
    "description",
    "version",
    "digest",
    "compatibility",
    "execution",
    "matches",
    "networkPolicy",
    "tools",
    "fixtures"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operationsVersion"],
          "properties": {
            "kind": {
              "const": "declarative"
            },
            "operationsVersion": {
              "enum": [1, 2]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "bundled"
            }
          }
        }
      ]
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/match"
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensionRequests"],
      "properties": {
        "extensionRequests": {
          "oneOf": [
            {
              "const": "none"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["origins", "methods"],
              "properties": {
                "origins": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://[^*/?#]+$"
                  }
                },
                "methods": {
                  "type": "array",
                  "items": {
                    "enum": ["GET", "POST"]
                  },
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 2
                }
              }
            }
          ]
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "stableSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "bridgeProtocol"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximumExclusive"],
          "properties": {
            "minimum": {
              "$ref": "#/$defs/stableSemver"
            },
            "maximumExclusive": {
              "$ref": "#/$defs/stableSemver"
            }
          }
        },
        "bridgeProtocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "paths"],
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^*/?#]+$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathRule"
          }
        },
        "wholeOrigin": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "paths": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "prefix"
                    },
                    "path": {
                      "const": "/"
                    }
                  },
                  "required": ["kind", "path"]
                }
              }
            },
            "required": ["paths"]
          },
          "then": {
            "properties": {
              "wholeOrigin": {
                "const": true
              }
            },
            "required": ["wholeOrigin"]
          },
          "else": {
            "not": {
              "properties": {
                "wholeOrigin": {
                  "const": true
                }
              },
              "required": ["wholeOrigin"]
            }
          }
        }
      ]
    },
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "enum": ["exact", "prefix"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!.*(?:/\\.{1,2})(?:/|$))(?!.*[%\\\\?#])(?!.*//).*$"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "risk",
        "permissions",
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "risk": {
          "enum": ["read", "action", "sensitive"]
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "READ",
              "ACTION",
              "SENSITIVE",
              "CREDENTIAL",
              "EXTERNAL_NETWORK",
              "ARBITRARY_EXECUTION"
            ]
          }
        },
        "inputSchema": {
          "type": "object",
          "required": ["type", "additionalProperties"],
          "properties": {
            "type": {
              "const": "object"
            },
            "additionalProperties": {
              "const": false
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": ["type", "additionalProperties"],
          "properties": {
            "type": {
              "const": "object"
            },
            "additionalProperties": {
              "const": false
            }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "input", "expect"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        },
        "tool": {
          "$ref": "#/$defs/tool/properties/name"
        },
        "input": {
          "type": "object"
        },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "result"],
              "properties": {
                "kind": {
                  "const": "result"
                },
                "result": true
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "code"],
              "properties": {
                "kind": {
                  "const": "error"
                },
                "code": {
                  "enum": [
                    "INVALID_REQUEST",
                    "CAPABILITY_DENIED",
                    "ORIGIN_MISMATCH",
                    "CONTEXT_NOT_FOUND",
                    "TOOL_NOT_FOUND",
                    "APPROVAL_REQUIRED",
                    "APPROVAL_DENIED",
                    "CANCELLED",
                    "TIMEOUT",
                    "EXECUTION_FAILED",
                    "RESULT_INVALID",
                    "INTERNAL_ERROR"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
