{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpatch.dev/schema/declarative-pack-bundle/v1",
  "title": "MCPatch Declarative Pack Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleVersion",
    "manifest",
    "operations",
    "metadata",
    "publisherSignature"
  ],
  "properties": {
    "bundleVersion": { "const": 1 },
    "manifest": { "$ref": "#/$defs/manifest" },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationsVersion", "program"],
      "properties": {
        "operationsVersion": { "const": 1 },
        "program": { "$ref": "#/$defs/json" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license"],
      "properties": {
        "license": { "type": "string", "minLength": 1, "maxLength": 128 },
        "homepage": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      }
    },
    "publisherSignature": { "$ref": "#/$defs/publisherSignature" },
    "registryAttestation": { "$ref": "#/$defs/registryAttestation" }
  },
  "$defs": {
    "json": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "string", "maxLength": 16384 },
        {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/json" }
        },
        {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": { "$ref": "#/$defs/json" }
        }
      ]
    },
    "semver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "stableSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "publisher",
        "id",
        "name",
        "description",
        "version",
        "digest",
        "compatibility",
        "execution",
        "matches",
        "networkPolicy",
        "tools",
        "fixtures"
      ],
      "properties": {
        "manifestVersion": { "const": 1 },
        "publisher": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "bridgeProtocol"],
          "properties": {
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimum", "maximumExclusive"],
              "properties": {
                "minimum": { "$ref": "#/$defs/stableSemver" },
                "maximumExclusive": { "$ref": "#/$defs/stableSemver" }
              }
            },
            "bridgeProtocol": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimum", "maximum"],
              "properties": {
                "minimum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "maximum": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operationsVersion"],
          "properties": {
            "kind": { "const": "declarative" },
            "operationsVersion": { "const": 1 }
          }
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/match" }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extensionRequests"],
          "properties": { "extensionRequests": { "const": "none" } }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/tool" }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/fixture" }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "paths"],
      "properties": {
        "origin": { "type": "string", "pattern": "^https://[^*/?#]+$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["exact", "prefix"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "risk",
        "permissions",
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "risk": { "enum": ["read", "action", "sensitive"] },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "enum": [
              "READ",
              "ACTION",
              "SENSITIVE",
              "CREDENTIAL",
              "EXTERNAL_NETWORK",
              "ARBITRARY_EXECUTION"
            ]
          }
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json" }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json" }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "input", "expect"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tool": { "type": "string", "minLength": 3, "maxLength": 128 },
        "input": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json" }
        },
        "expect": { "$ref": "#/$defs/json" }
      }
    },
    "publisherSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatureVersion",
        "algorithm",
        "publisher",
        "keyId",
        "publicKey",
        "signature"
      ],
      "properties": {
        "signatureVersion": { "const": 1 },
        "algorithm": { "const": "Ed25519" },
        "publisher": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "keyId": {
          "type": "string",
          "minLength": 83,
          "maxLength": 144,
          "pattern": "^ed25519:[a-z][a-z0-9.-]{1,63}:sha256:[a-f0-9]{64}$"
        },
        "publicKey": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "registryAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestationVersion",
        "registryId",
        "keyId",
        "publisher",
        "id",
        "version",
        "bundleDigest",
        "publicationSequence",
        "reviewState",
        "issuedAt",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "attestationVersion": { "const": 1 },
        "registryId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,63}$"
        },
        "keyId": {
          "type": "string",
          "minLength": 82,
          "maxLength": 144,
          "pattern": "^ed25519:[a-z][a-z0-9.-]{1,63}:sha256:[a-f0-9]{64}$"
        },
        "publisher": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "$ref": "#/$defs/semver" },
        "bundleDigest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "publicationSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reviewState": { "enum": ["OFFICIAL", "REVIEWED_COMMUNITY"] },
        "issuedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "signature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
