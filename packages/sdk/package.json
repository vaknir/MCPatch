{
  "name": "@mcpatch/sdk",
  "version": "0.3.0",
  "private": true,
  "description": "Safe MCPatch pack contracts and authoring SDK",
  "type": "module",
  "files": [
    "dist",
    "schema",
    "fixtures"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./schema/v1/*": "./schema/v1/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:fixtures": "vitest run tests/fixture-harness*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4"
  }
}
