{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mcpatch.dev/protocol/v2/capabilities.schema.json",
  "title": "MCPatch protocol v2 capability messages",
  "$defs": {
    "packReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "id", "version", "digest"],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "origin",
        "source",
        "risk",
        "permissions",
        "inputSchema"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/toolName"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "origin": {
          "$ref": "common.schema.json#/$defs/origin"
        },
        "source": {
          "enum": ["native_webmcp", "pack"]
        },
        "pack": {
          "$ref": "#/$defs/packReference"
        },
        "risk": {
          "$ref": "common.schema.json#/$defs/risk"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/permission"
          }
        },
        "inputSchema": {
          "$ref": "common.schema.json#/$defs/inputSchema"
        },
        "outputSchema": {
          "$ref": "common.schema.json#/$defs/jsonSchema"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "pack"
              }
            }
          },
          "then": {
            "properties": {
              "pack": true,
              "outputSchema": true
            },
            "required": ["pack", "outputSchema"]
          },
          "else": {
            "not": {
              "properties": {
                "pack": true
              },
              "required": ["pack"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "read"
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "type": "array",
                "contains": {
                  "const": "READ"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "action"
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "type": "array",
                "contains": {
                  "const": "ACTION"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "sensitive"
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "type": "array",
                "contains": {
                  "const": "SENSITIVE"
                }
              }
            }
          }
        }
      ]
    },
    "capabilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "contextId",
        "contextRevision",
        "origin",
        "capabilities"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "type": {
          "const": "capability_snapshot"
        },
        "contextId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "contextRevision": {
          "$ref": "common.schema.json#/$defs/positiveSafeInteger"
        },
        "origin": {
          "$ref": "common.schema.json#/$defs/origin"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "contextClosed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "contextId",
        "contextRevision",
        "reason"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "type": {
          "const": "context_closed"
        },
        "contextId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "contextRevision": {
          "$ref": "common.schema.json#/$defs/positiveSafeInteger"
        },
        "reason": {
          "enum": ["navigation", "tab_closed", "pack_disabled", "disconnected"]
        }
      }
    }
  }
}
