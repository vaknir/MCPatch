{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mcpatch.dev/protocol/v1/common.schema.json",
  "title": "MCPatch protocol v1 common types",
  "$defs": {
    "protocolVersion": {
      "const": 1
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "toolName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://[^/?#@]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "jsonSchema": {
      "type": "object",
      "maxProperties": 128
    },
    "inputSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/jsonSchema"
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        }
      ]
    },
    "permission": {
      "enum": [
        "READ",
        "ACTION",
        "SENSITIVE",
        "CREDENTIAL",
        "EXTERNAL_NETWORK",
        "ARBITRARY_EXECUTION"
      ]
    },
    "risk": {
      "enum": ["read", "action", "sensitive"]
    },
    "errorCode": {
      "enum": [
        "INVALID_REQUEST",
        "UNSUPPORTED_VERSION",
        "INVALID_STATE",
        "UNAUTHORIZED",
        "CAPABILITY_DENIED",
        "ORIGIN_MISMATCH",
        "CONTEXT_NOT_FOUND",
        "TOOL_NOT_FOUND",
        "APPROVAL_REQUIRED",
        "APPROVAL_DENIED",
        "CANCELLED",
        "TIMEOUT",
        "EXECUTION_FAILED",
        "RESULT_INVALID",
        "INTERNAL_ERROR"
      ]
    }
  }
}
