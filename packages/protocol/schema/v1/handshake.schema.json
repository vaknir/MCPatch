{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mcpatch.dev/protocol/v1/handshake.schema.json",
  "title": "MCPatch protocol v1 handshake messages",
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "role",
        "supportedProtocolVersions",
        "implementation"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "type": {
          "const": "hello"
        },
        "role": {
          "enum": ["bridge", "extension"]
        },
        "supportedProtocolVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/positiveVersion"
          }
        },
        "implementation": {
          "$ref": "common.schema.json#/$defs/implementation"
        }
      }
    },
    "helloAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "selectedProtocolVersion",
        "connectionId",
        "implementation"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "type": {
          "const": "hello_ack"
        },
        "selectedProtocolVersion": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "connectionId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "implementation": {
          "$ref": "common.schema.json#/$defs/implementation"
        }
      }
    }
  }
}
