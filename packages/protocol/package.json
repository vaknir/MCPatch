{
  "name": "@mcpatch/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical MCPatch bridge protocol schemas, types, and validators",
  "type": "module",
  "files": [
    "dist",
    "schema",
    "fixtures"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/v1/*": "./schema/v1/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
